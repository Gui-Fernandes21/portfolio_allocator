# Copy to .env and fill in. .env must never be committed.
#
# Required only by the LLM-backed agents (Market Analyst, Sentiment
# Analyser, Coordinator). The offline pipeline, the allocation endpoint and
# the whole test suite run without it.
OPENROUTER_API_KEY=

# Optional: override the per-role default model (anthropic/claude-haiku-4.5).
# OPENROUTER_MODEL=
